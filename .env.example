# ==============================================================================
# SERVER ENVIRONMENT CONFIGURATION EXAMPLE
# ==============================================================================

# Port the Express server will listen on (default is 3000)
PORT=3000

# Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API)
# Example: https://your-project-ref.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Service Role Secret or Anon Key
# Recommendation: Use the "service_role" secret for backend server operations
# Found in: Supabase Dashboard -> Project Settings -> API -> Project API keys
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_key_here
